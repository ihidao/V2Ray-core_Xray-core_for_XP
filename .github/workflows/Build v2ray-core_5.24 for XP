name: Build v2ray-core 5.24 for Windows XP

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch: # 允许在 GitHub 网页上手动触发

jobs:
  build-windows-xp:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout v2ray-core source code
      uses: actions/checkout@v4
      with:
        repository: v2fly/v2ray-core
        ref: v5.24.0 # 指定 v5.24.0 版本，可根据需要修改 tag

    - name: Download Custom Go 1.21 for XP
      run: |
        # ⚠️ 重要：请将下面的 URL 替换为你实际使用的、支持 Windows XP 的魔改 Go 1.21 的 Linux 版本下载链接！
        # 这里使用了一个占位符示例，你需要去 GitHub 寻找类似 skylee/go-win-xp 或其他 fork 的 release 链接。
        CUSTOM_GO_URL="https://example.com/go1.21.13-xp.linux-amd64.tar.gz" 
        
        echo "Downloading custom Go from $CUSTOM_GO_URL..."
        wget $CUSTOM_GO_URL -O go-xp.tar.gz
        
        mkdir -p $HOME/go-xp
        tar -C $HOME/go-xp -xzf go-xp.tar.gz --strip-components=1
        
        # 配置环境变量，让系统优先使用这个魔改版 Go
        echo "GOROOT=$HOME/go-xp" >> $GITHUB_ENV
        echo "$HOME/go-xp/bin" >> $GITHUB_PATH
        
        # 验证版本
        go version

    - name: Setup Go Modules and Downgrade Dependencies
      run: |
        # 下载基础依赖
        go mod download
        
        # ⚠️ 核心兼容性处理：降级 golang.org/x/sys
        # 新版 x/sys 大量使用了 Vista/Win7 的 API，降级到 v0.1.0 可以大幅提高 XP 兼容性
        echo "Downgrading golang.org/x/sys for XP compatibility..."
        go get golang.org/x/sys@v0.1.0
        go mod tidy

    - name: Install go-winres
      run: |
        # 安装用于生成 Windows 图标和 Manifest 的工具
        go install github.com/tc-hib/go-winres@latest

    - name: Generate Windows Resources (Icon & Manifest)
      run: |
        # v2ray v5 的主程序入口在 ./main 目录
        cd main
        
        # 初始化并生成 Windows 资源文件 (.syso)
        # 如果官方仓库自带了 winres.json 则直接使用，否则生成一个默认的
        if [ ! -f winres.json ]; then
          go-winres init
        fi
        
        go-winres make
        echo "Windows resources generated successfully."

    - name: Build v2ray-core_5.24 for XP
      env:
        GOOS: windows
        GOARCH: 386      # 编译 32位 (386)，对 Windows XP 兼容性最佳
        CGO_ENABLED: 0   # 禁用 CGO，生成纯静态链接的可执行文件
      run: |
        cd main
        echo "Starting build process..."
        
        # 编译参数说明：
        # -trimpath: 移除本地路径信息
        # -ldflags "-s -w": 剥离调试符号，减小体积
        # -H=windowsgui: 编译为 GUI 程序，运行时不弹出黑色 CMD 窗口
        go build -v -trimpath -ldflags "-s -w -H=windowsgui" -o v2ray.exe .
        
        echo "Build completed. Checking file size..."
        ls -lh v2ray.exe

    - name: Upload Artifact
      uses: actions/upload-artifact@v4
      with:
        name: v2ray-windows-xp-386
        path: main/v2ray.exe
        retention-days: 7 # 保留 7 天
